(* -------------------------------------------------------------------- *)
(* The Poly1305 modulus 2^130 - 5 is prime: a chain of Pocklington      *)
(* certificates (generated by factoring N - 1 and choosing witnesses).  *)
require import AllCore List IntDiv Pocklington.

op p1305 : int = 2 ^ 130 - 5.

lemma p1305E : p1305 = 1361129467683753853853498429727072845819.
proof. by rewrite /p1305; cbv hint {expr0 expr_pred}. qed.

section.
local lemma prime_5 : prime 5.
proof. apply (pock_certif 5 [(2, 2); (2, 2)]); [by cbv delta hint +gcd +powmod | by rewrite /= prime2]. qed.
local lemma prime_11 : prime 11.
proof. apply (pock_certif 11 [(5, 2)]); [by cbv delta hint +gcd +powmod | by rewrite /= prime_5]. qed.
local lemma prime_67 : prime 67.
proof. apply (pock_certif 67 [(11, 2)]); [by cbv delta hint +gcd +powmod | by rewrite /= prime_11]. qed.
local lemma prime_881 : prime 881.
proof. apply (pock_certif 881 [(11, 2); (5, 2)]); [by cbv delta hint +gcd +powmod | by rewrite /= prime_11 prime_5]. qed.
local lemma prime_37003 : prime 37003.
proof. apply (pock_certif 37003 [(881, 2)]); [by cbv delta hint +gcd +powmod | by rewrite /= prime_881]. qed.
local lemma prime_221101 : prime 221101.
proof. apply (pock_certif 221101 [(67, 2); (11, 2)]); [by cbv delta hint +gcd +powmod | by rewrite /= prime_11 prime_67]. qed.
local lemma prime_4024685905107147541 : prime 4024685905107147541.
proof. apply (pock_certif 4024685905107147541 [(221101, 2); (37003, 2)]); [by cbv delta hint +gcd +powmod | by rewrite /= prime_221101 prime_37003]. qed.
local lemma prime_897064739519922787230182993783 : prime 897064739519922787230182993783.
proof. apply (pock_certif 897064739519922787230182993783 [(4024685905107147541, 2)]); [by cbv delta hint +gcd +powmod | by rewrite /= prime_4024685905107147541]. qed.

lemma prime_p1305 : prime p1305.
proof.
rewrite p1305E.
apply (pock_certif 1361129467683753853853498429727072845819
                   [(897064739519922787230182993783, 2)]).
- by cbv delta hint +gcd +powmod.
by rewrite /= prime_897064739519922787230182993783.
qed.
end section.
