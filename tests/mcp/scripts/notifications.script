# exit: 0
# Notifications never draw a reply, whatever they are: the three the
# spec has us tolerate, an unknown one, and a message whose id is
# null (which MCP forbids, so we read it as "no id" and stay silent).
# The two pings bracket them, so the golden shows nothing in between.
{"jsonrpc":"2.0","id":1,"method":"ping"}
{"jsonrpc":"2.0","method":"notifications/initialized"}
{"jsonrpc":"2.0","method":"notifications/cancelled","params":{"requestId":1}}
{"jsonrpc":"2.0","method":"notifications/roots/list_changed"}
{"jsonrpc":"2.0","method":"notifications/nobody/knows"}
{"jsonrpc":"2.0","id":null,"method":"ping"}

{"jsonrpc":"2.0","id":2,"method":"ping"}
